<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form.tax.policy</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- Appending to the outer group of the page instead of anchoring
                 on a field keeps this working untouched on 17.0, 18.0 and
                 19.0, and lines our group up with the neighbouring ones. -->
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group name="journal_tax_policy" string="Taxes"
                       invisible="type not in ('sale', 'purchase')">
                    <field name="tax_policy" widget="radio"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
